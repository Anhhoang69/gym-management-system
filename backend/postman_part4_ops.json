{
  "info": {
    "_postman_id": "gym-mgmt-v2-part4",
    "name": "Gym Management System API – Part 4 (Attendance + Class + Payroll + Notification + Requests + Reports + AI)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dynamic pre-request sequence in background using pm.sendRequest() to avoid extra request counts in Newman",
          "if (!pm.environment.get('receptionistToken')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ emailOrPhone: pm.environment.get('staffEmail'), password: pm.environment.get('staffPass') }) }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200) pm.environment.set('receptionistToken', res.json().data.token);",
          "  });",
          "}",
          "if (!pm.environment.get('gymOwnerToken')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ emailOrPhone: pm.environment.get('gymOwnerEmail'), password: pm.environment.get('gymOwnerPass') }) }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200) pm.environment.set('gymOwnerToken', res.json().data.token);",
          "  });",
          "}",
          "if (!pm.environment.get('memberToken')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ emailOrPhone: pm.environment.get('memberEmail'), password: pm.environment.get('memberPass') }) }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200) pm.environment.set('memberToken', res.json().data.token);",
          "  });",
          "}",
          "if (!pm.environment.get('memberUserId')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/users?search=' + pm.environment.get('memberEmail'),",
          "    method: 'GET',",
          "    header: { 'Authorization': 'Bearer ' + pm.environment.get('superAdminToken') }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200) {",
          "      const user = res.json().data.items.find(i => i.email === pm.environment.get('memberEmail'));",
          "      if (user) pm.environment.set('memberUserId', user.userId);",
          "    }",
          "  });",
          "}",
          "if (!pm.environment.get('ptStaffUserId')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/users?page=1&pageSize=50&role=PT',",
          "    method: 'GET',",
          "    header: { 'Authorization': 'Bearer ' + pm.environment.get('superAdminToken') }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200 && res.json().data.items.length > 0) {",
          "      pm.environment.set('ptStaffUserId', res.json().data.items[0].userId);",
          "    }",
          "  });",
          "}",
          "if (!pm.environment.get('roomId')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/rooms?branchId=' + pm.environment.get('branchId'),",
          "    method: 'GET',",
          "    header: { 'Authorization': 'Bearer ' + pm.environment.get('superAdminToken') }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200 && res.json().data.length > 0) {",
          "      pm.environment.set('roomId', res.json().data[0].roomId);",
          "    }",
          "  });",
          "}",
          "if (!pm.environment.get('cardCode') && pm.environment.get('memberUserId')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/users/' + pm.environment.get('memberUserId'),",
          "    method: 'GET',",
          "    header: { 'Authorization': 'Bearer ' + pm.environment.get('superAdminToken') }",
          "  }, (err, res) => {",
          "    if (res && res.code === 200 && res.json().data.memberInfo && res.json().data.memberInfo.accessCard) {",
          "      pm.environment.set('cardCode', res.json().data.memberInfo.accessCard.cardCode);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],

{
  "info": {
    "_postman_id": "gym-part4",
    "name": "Gym Management System API – Part 4 (Attendance + Class + Payroll + Notifications + AI)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Part 4 Setup",
      "item": [
        {
          "name": "Login - GymOwner (for Setup)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
            "const j = pm.response.json();",
            "if(j.data && j.data.token) pm.environment.set('gymOwnerToken', j.data.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOrPhone\":\"{{gymOwnerEmail}}\",\"password\":\"{{gymOwnerPass}}\"}" }
          }
        },
        {
          "name": "Login - Registered Member (for Setup)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
            "const j = pm.response.json();",
            "if(j.data && j.data.token) pm.environment.set('memberToken', j.data.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOrPhone\":\"{{memberEmail}}\",\"password\":\"{{memberPass}}\"}" }
          }
        },
        {
          "name": "Get Receptionist / Staff Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "if(j.data && j.data.token) pm.environment.set('receptionistToken', j.data.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOrPhone\":\"{{staffEmail}}\",\"password\":\"{{staffPass}}\"}" }
          }
        },
        {
          "name": "Sync Member ID by Email",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "if(j.data && j.data.items && j.data.items.length > 0) {",
            "  const user = j.data.items.find(i => i.email === pm.environment.get('memberEmail'));",
            "  if(user) {",
            "    pm.environment.set('memberUserId', user.userId);",
            "  }",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/users?search={{memberEmail}}"
          }
        },
        {
          "name": "Get PT Staff",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "if(j.data && j.data.items && j.data.items.length > 0) {",
            "  pm.environment.set('ptStaffUserId', j.data.items[0].userId);",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/users?page=1&pageSize=50&role=PT"
          }
        },
        {
          "name": "Get Rooms",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "if(j.data && j.data.length > 0) pm.environment.set('roomId', j.data[0].roomId);"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staffToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/rooms"
          }
        },
        {
          "name": "Ensure Member Has Card",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "if(j.data && j.data.memberInfo && j.data.memberInfo.accessCard) {",
            "  pm.environment.set('cardCode', j.data.memberInfo.accessCard.cardCode);",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{memberUserId}}"
          }
        }
      ]
    },
    {
      "name": "14. Attendance",
      "item": [
        {
          "name": "Check-in by Card",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/attendance/checkin",
            "body": { "mode": "raw", "raw": "{\"cardNumber\":\"{{cardCode}}\",\"branchId\":\"{{branchId}}\"}" }
          }
        },
        {
          "name": "Manual Check-in",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/attendance/checkin/manual",
            "body": { "mode": "raw", "raw": "{\"memberUserId\":\"{{memberUserId}}\",\"branchId\":\"{{branchId}}\",\"note\":\"Quên thẻ\"}" }
          }
        },
        {
          "name": "Get My Attendance (Member)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/attendance/my"
          }
        },
        {
          "name": "Get Branch Attendance",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/attendance/branch/{{branchId}}"
          }
        },
        {
          "name": "Check-out Attendance",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/attendance/checkout",
            "body": { "mode": "raw", "raw": "{\"cardNumber\":\"{{cardCode}}\",\"branchId\":\"{{branchId}}\"}" }
          }
        }
      ]
    },
    {
      "name": "15. Class Scheduling",
      "item": [
        {
          "name": "Get Class Schedule",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "if(j.data && j.data.length > 0) pm.environment.set('classId', j.data[0].classId);"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/classes?branchId={{branchId}}"
          }
        },
        {
          "name": "Create Class (Admin)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));",
            "if(j.data) pm.environment.set('classId', j.data);"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/classes",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Yoga Morning {{$timestamp}}\",\"description\":\"Fresh start\",\"date\":\"2026-12-30\",\"startTime\":\"10:00:00\",\"endTime\":\"11:00:00\",\"classType\":\"Yoga\",\"capacity\":2,\"minCapacity\":1,\"trainerStaffId\":\"{{ptStaffUserId}}\",\"roomId\":\"{{roomId}}\"}"
            }
          }
        },
        {
          "name": "Book Class (Member)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "POST",
            "url": "{{baseUrl}}/api/classes/{{classId}}/book"
          }
        },
        {
          "name": "Get My Bookings (Member)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/classes/my-bookings"
          }
        },
        {
          "name": "Class Check-in (Staff)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/classes/{{classId}}/class-checkin",
            "body": { "mode": "raw", "raw": "{\"memberUserId\":\"{{memberUserId}}\"}" }
          }
        },
        {
          "name": "Cancel Booking (Member)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/classes/{{classId}}/cancel-booking",
            "body": { "mode": "raw", "raw": "{\"cancelReason\":\"Bận việc đột xuất\"}" }
          }
        }
      ]
    },
    {
      "name": "16. Payroll",
      "item": [
        {
          "name": "Get Payroll Formulas",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/payroll/formula"
          }
        },
        {
          "name": "Calculate Payroll",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/payroll/calculate",
            "body": { "mode": "raw", "raw": "{\"month\":5,\"year\":2026,\"branchId\":\"{{branchId}}\"}" }
          }
        },
        {
          "name": "Approve Payroll Period (GymOwner)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{gymOwnerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/payroll/approve-period",
            "body": { "mode": "raw", "raw": "{\"month\":5,\"year\":2026}" }
          }
        },
        {
          "name": "Get My Payroll (Staff)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staffToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/payroll/my?month=5&year=2026"
          }
        }
      ]
    },
    {
      "name": "17. Notification & AI",
      "item": [
        {
          "name": "Send Notification",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/notifications/send",
            "body": { "mode": "raw", "raw": "{\"title\":\"Test Notification\",\"message\":\"Hello from Postman!\",\"userIds\":[\"{{memberUserId}}\"],\"type\":\"Info\"}" }
          }
        },
        {
          "name": "Get My Notifications",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications?page=1&pageSize=10"
          }
        },
        {
          "name": "Mark All Read",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": "{{baseUrl}}/api/notifications/read-all"
          }
        },
        {
          "name": "AI Chat",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/ai/chat",
            "body": { "mode": "raw", "raw": "{\"message\":\"Chào bạn, mình mới tập gym!\"}" }
          }
        }
      ]
    },
    {
      "name": "18. Reports & Audits",
      "item": [
        {
          "name": "KPI Overview",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/reports/overview"
          }
        },
        {
          "name": "Revenue Report",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/reports/revenue?year=2026"
          }
        },
        {
          "name": "Get Audit Logs",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },

{
  "info": {
    "_postman_id": "gym-part3",
    "name": "GMS Part3 - Lead/Member/Contract/Invoice/Payment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Setup Roles",
      "item": [
        {
          "name": "Reset Environment Variables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('leadId', null);",
                  "pm.environment.set('memberUserId', null);",
                  "pm.environment.set('contractId', null);",
                  "pm.environment.set('invoiceId', null);",
                  "pm.environment.set('draftId', null);",
                  "pm.environment.set('paymentId', null);",
                  "console.log('Environment IDs reset');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Login - Receptionist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if(j.data && j.data.token) pm.environment.set('receptionistToken', j.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"{{receptionistEmail}}\",\n  \"password\": \"User@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - Sales",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if(j.data && j.data.token) pm.environment.set('staffToken', j.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"staff@gym.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Init Packages (for Part 3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "const validPackage = (j.data || []).find(p => p.pricings && p.pricings.length > 0 && p.status === 'Active');",
                  "if(validPackage) {",
                  "  pm.environment.set('packageId', validPackage.packageId);",
                  "  pm.environment.set('pricingId', validPackage.pricings[0].packagePricingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/packages"
          }
        },
        {
          "name": "Init Branch (for Part 3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "if(j.data && j.data.length > 0) pm.environment.set('branchId', j.data[0].branchId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/branches"
          }
        }
      ]
    },
    {
      "name": "09. Lead Sources",
      "item": [
        {
          "name": "Get Lead Sources",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Array returned', () => pm.expect(j.data).to.be.an('array'));",
                  "if(j.data && j.data.length > 0) pm.environment.set('leadSourceId', j.data[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/lead-sources"
          }
        },
        {
          "name": "Create Lead Source",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Name returned', () => pm.expect(pm.response.json().data.name).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/lead-sources",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Instagram\",\"score\":18}"
            }
          }
        },
        {
          "name": "Update Lead Source",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Message exists', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/lead-sources/{{leadSourceId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Instagram (Updated)\",\"score\":20}"
            }
          }
        }
      ]
    },
    {
      "name": "10. Lead Management",
      "item": [
        {
          "name": "Get Lead List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paged result', () => pm.expect(j.data).to.have.property('items'));",
                  "if(j.data.items && j.data.items.length > 0) pm.environment.set('leadId', j.data.items[0].leadId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/leads?page=1&pageSize=10"
          }
        },
        {
          "name": "Get Lead Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/leads/stats"
          }
        },
        {
          "name": "Create Lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if(j.data) pm.environment.set('leadId', j.data.leadId || j.data.LeadId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/leads",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lead {{$timestamp}}\",\n  \"phone\": \"{{randomPhone}}\",\n  \"email\": \"lead_{{$timestamp}}@mail.local\",\n  \"branchId\": \"{{branchId}}\",\n  \"sourceId\": \"{{leadSourceId}}\"\n}"
            }
          }
        },
        {
          "name": "Create Lead - Missing Phone (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/leads",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Missing Phone Lead\",\"branchId\":\"{{branchId}}\",\"sourceId\":\"{{leadSourceId}}\"}"
            }
          }
        },
        {
          "name": "Contact Lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is Contacted', () => pm.expect(pm.response.json().data.status).to.equal('Contacted'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/leads/{{leadId}}/contact"
          }
        },

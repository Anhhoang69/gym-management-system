    {
      "name": "12. Contract",
      "item": [
        {
          "name": "Create Contract Draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('DraftId returned', () => pm.expect(j.data.draftId).to.be.a('string'));",
                  "if(j.data && j.data.draftId) pm.environment.set('draftId', j.data.draftId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/contracts/draft",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberUserId\": \"{{memberUserId}}\",\n  \"packageId\": \"{{packageId}}\",\n  \"pricingId\": \"{{pricingId}}\",\n  \"startDate\": \"2026-01-01T00:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Generate Contract from Draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ContractId returned', () => pm.expect(j.data.contractId).to.be.a('string'));",
                  "pm.test('Status is Pending', () => pm.expect(j.data.status).to.equal('Pending'));",
                  "if(j.data && j.data.contractId) pm.environment.set('contractId', j.data.contractId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/contracts",

            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/leads/{{leadId}}/convert-to-member",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": \"{{packageId}}\",\n  \"pricingId\": \"{{pricingId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"startDate\": \"2026-01-01T00:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Get Lead Detail by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('LeadId exists', () => pm.expect(pm.response.json().data.leadId).to.be.a('string'));"
                ],
                "type": "text/javascript"

                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if(j.data) {",
                  "  pm.environment.set('memberUserId', j.data.memberUserId || j.data.MemberUserId);",
                  "  pm.environment.set('contractId', j.data.contractId || j.data.ContractId);",
                  "  pm.environment.set('invoiceId', j.data.invoiceId || j.data.InvoiceId);",
                  "  pm.environment.set('totalAmountDue', j.data.totalAmountDue || j.data.TotalAmountDue);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"

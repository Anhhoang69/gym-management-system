            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          }
        },
        {
          "name": "Update Lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/leads/{{leadId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Lead {{$timestamp}}\",\n  \"email\": \"updated_{{$timestamp}}@mail.com\",\n  \"phone\": \"{{randomPhone}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"sourceId\": \"{{leadSourceId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "11. Member (Quick Register)",
      "item": [
        {
          "name": "Quick Register Walk-in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if(pm.response.code >= 400) console.log(pm.info.itemName + ' Error:', pm.response.text());",
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if(j.data) {",
                  "  pm.environment.set('memberUserId', j.data.memberUserId || j.data.MemberUserId);",
                  "  pm.environment.set('contractId', j.data.contractId || j.data.ContractId);",
                  "  pm.environment.set('invoiceId', j.data.invoiceId || j.data.InvoiceId);",
                  "  pm.environment.set('totalAmountDue', j.data.totalAmountDue || j.data.TotalAmountDue);",
                  "}"

  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Login - SuperAdmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token exists', () => pm.expect(j.data.token).to.be.a('string'));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "if(j.data && j.data.token){ pm.environment.set('accessToken', j.data.token); pm.environment.set('superAdminToken', j.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"emailOrPhone\":\"{{superAdminEmail}}\",\"password\":\"{{superAdminPass}}\"}"
            }
          }
        },

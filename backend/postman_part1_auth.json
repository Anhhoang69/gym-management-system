            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message exists', () => {",
                  "  const j = pm.response.json();",
                  "  if(j.message) pm.expect(j).to.have.property('message');",
                  "  else pm.expect(j).to.have.property('errors');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {

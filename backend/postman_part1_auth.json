    {
      "name": "02. Register (Public)",
      "item": [
        {
          "name": "Get Public Packages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Data is array', () => pm.expect(j.data).to.be.an('array'));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "if(j.data && j.data.length > 0){",
                  "  pm.environment.set('packageId', j.data[0].packageId);",
                  "  if(j.data[0].pricings && j.data[0].pricings.length > 0) pm.environment.set('pricingId', j.data[0].pricings[0].packagePricingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/register/packages"
          }
        },
        {
          "name": "Register Member (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('ContractId exists', () => pm.expect(j.data.contractId).to.be.a('string'));",
                  "pm.test('InvoiceId exists', () => pm.expect(j.data.invoiceId).to.be.a('string'));",
                  "if(j.data && j.data.memberId) pm.environment.set('memberUserId', j.data.memberId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/register",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"Test Member\",\"email\":\"testmember_{{$timestamp}}@gym.com\",\"phoneNumber\":\"09{{$randomInt}}{{$randomInt}}\",\"packageId\":\"{{packageId}}\",\"pricingId\":\"{{pricingId}}\",\"branchId\":\"{{branchId}}\"}"
            }
          }
        },
        {
          "name": "Register - Missing Required Fields (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/register",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"Test\"}"
            }
          }
        }
      ]
    },
    {
      "name": "03. Profile (Me)",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('FullName exists', () => pm.expect(j.data.fullName).to.be.a('string'));",
                  "pm.test('Email exists', () => pm.expect(j.data.email).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/me"
          }
        },
        {
          "name": "Update My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/me",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"System Super Admin\",\"address\":\"Ho Chi Minh City\"}"
            }
          }
        },
        {
          "name": "Get Login History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if(j.data && j.data.items && j.data.items.length > 0) pm.environment.set('loginHistoryId', j.data.items[0].loginHistoryId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/me/login-history?page=1&pageSize=10"
          }
        },
        {
          "name": "Revoke Specific Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/me/sessions/{{loginHistoryId}}"
          }
        },
        {
          "name": "Get Profile - Unauthorized (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/me"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.environment.set('randomPhone', '09' + Math.floor(10000000 + Math.random() * 90000000));"
        ],
        "type": "text/javascript"
      }
    }
  ]
